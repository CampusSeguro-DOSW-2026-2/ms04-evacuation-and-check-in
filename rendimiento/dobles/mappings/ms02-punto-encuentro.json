{
  "name": "MS02: GET /api/v1/safe-zones/{id} responde una zona segura ACTIVA con el id pedido",
  "request": { "method": "GET", "urlPathPattern": "/api/v1/safe-zones/[^/]+" },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "body": "{\"id\":\"{{regexExtract request.path '[^/]+$'}}\",\"codigo\":\"MP-01\",\"nombre\":\"Punto de encuentro de prueba\",\"estado\":\"ACTIVO\"}",
    "transformers": ["response-template"],
    "delayDistribution": { "type": "uniform", "lower": 20, "upper": 120 }
  }
}
