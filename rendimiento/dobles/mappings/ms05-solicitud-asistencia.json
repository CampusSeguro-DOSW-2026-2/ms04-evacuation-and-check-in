{
  "name": "MS05: POST /api/v1/incidentes/eventos/{eventoId} registra la solicitud de asistencia y responde su idIncidente",
  "request": { "method": "POST", "urlPathPattern": "/api/v1/incidentes/eventos/[^/]+" },
  "response": {
    "status": 201,
    "headers": { "Content-Type": "application/json" },
    "body": "{\"idIncidente\":\"SOL-{{randomValue length=10 type='ALPHANUMERIC'}}\",\"estado\":\"REPORTADA\"}",
    "transformers": ["response-template"],
    "delayDistribution": { "type": "uniform", "lower": 20, "upper": 120 }
  }
}
