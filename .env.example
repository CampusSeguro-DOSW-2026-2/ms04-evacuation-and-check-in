# Copie este archivo como .env y complete los valores. El archivo .env nunca se sube al repositorio.
# La aplicación lo lee al arrancar (spring.config.import) y docker compose también lo usa.

# Base de datos propia de MS04 (PostgreSQL)
DB_NAME=ms04_db
DB_USERNAME=ms04_user
DB_PASSWORD=ms04_password
# Puerto del host donde docker compose publica PostgreSQL en desarrollo (MS01 usa el 5432)
DB_HOST_PORT=5434
DB_URL=jdbc:postgresql://localhost:5434/ms04_db

# Puerto interno de MS04 (Estándares, sección 2)
SERVER_PORT=8084
LOG_LEVEL=INFO

# Llamadas salientes a MS01, MS02, MS05 y MS08 a través del API Gateway (Estándares, sección 5)
# Si GATEWAY_URL queda vacía, la auditoría solo se registra en el log
GATEWAY_URL=
# Clave de servicio de MS04 (aleatoria, al menos 32 caracteres), la misma que GW_SERVICE_KEY_MS04 del Gateway
GATEWAY_SERVICE_KEY=
GATEWAY_TIMEOUT_MS=2000
# Rutas de los otros servicios detrás del Gateway. La de MS05 es provisional hasta acordar su contrato
MS02_SAFE_ZONES_PATH=/api/v1/safe-zones/{id}
MS05_SOLICITUDES_PATH=/api/v1/internal/solicitudes-asistencia
# Cada cuántos milisegundos se reenvían a MS05 las solicitudes de asistencia pendientes de envío
MS04_REENVIO_SOLICITUDES_MS=30000

# Servicios autorizados para las rutas internas de MS04 (el Gateway envía ms01 ... ms08 en X-Service-Name)
INTERNAL_ALLOWED_SERVICES=ms06

# Swagger solo en desarrollo local
SWAGGER_ENABLED=false
